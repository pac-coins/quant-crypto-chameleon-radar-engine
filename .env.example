# Opcoes de MODE: ANALYST_ONLY | SHADOW_CHAMELEON | LIVE_CHAMELEON_PHASE_1 | LIVE_CHAMELEON_PHASE_2
MODE=ANALYST_ONLY
# Opcoes de BINANCE_ENV: TESTNET | PRODUCTION (lido apenas em LIVE)
BINANCE_ENV=TESTNET
BINANCE_API_KEY=
BINANCE_ED25519_PRIVATE_KEY_PATH=
LIVE_CONFIRMATION=
APPROVED_STRATEGIES_SHA256=
SHADOW_INITIAL_USDT=300.00
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DB_PATH=/app/data/quant.db
BACKUP_DIR=/app/data/backups
# Retencao de backups locais (quantidade de arquivos mais recentes mantidos em BACKUP_DIR)
BACKUP_RETENTION_DAYS=14
# Intervalo do watchdog sub-horario para STOP_LOSS_LIMIT pendurado (ativo apenas com posicao aberta)
WATCHDOG_POLL_INTERVAL_SECONDS=20
# Heartbeat externo opcional (dead-man switch, ex.: Healthchecks.io / Uptime Kuma); vazio = desligado
HEALTHCHECK_URL=
# Backup fora da VM via Telegram sendDocument (< 50 MB, C2-8); desligado por padrao
OFFSITE_BACKUP_ENABLED=false
# Chat/canal privado opcional para backups (vazio = usa TELEGRAM_CHAT_ID)
BACKUP_TELEGRAM_CHAT_ID=
# Chave Fernet obrigatoria quando OFFSITE_BACKUP_ENABLED=true (falha no boot se vazia)
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=
# Artefato JSON assinado do Juiz de IA calibrado (modo observador silencioso na Fase 1; vazio = padrao)
ML_JUDGE_ARTIFACT_PATH=
